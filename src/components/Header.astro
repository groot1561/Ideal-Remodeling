---
import { siteConfig } from '../data/siteConfig';
import MobileMenu from './MobileMenu.astro';
---

<header
  id="site-header"
  class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 w-[93%] max-w-7xl z-50 transition-all duration-500 rounded-full bg-warm-950/85 backdrop-blur-xl border border-warm-800/80 shadow-2xl px-6 sm:px-8 py-3.5"
>
  <div class="flex items-center justify-between">
    
    <!-- LEFT: Building Logo Icon Badge & Single SVG Brand Image -->
    <a
      href="#hero"
      class="group flex items-center space-x-3.5 focus:outline-none focus:ring-1 focus:ring-bronze rounded-full py-0.5"
    >
      <!-- Architectural Building Logo Icon Badge -->
      <div class="w-9 h-9 rounded-full bg-bronze/15 border border-bronze/40 flex items-center justify-center group-hover:bg-bronze transition-all duration-300 shadow-sm p-1.5 shrink-0">
        <svg class="w-4.5 h-4.5 text-bronze group-hover:text-warm-950 transition-colors" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/>
          <path d="M6 12H4a2 2 0 0 0-2 2v8h20v-8a2 2 0 0 0-2-2h-2"/>
          <path d="M10 6h4"/>
          <path d="M10 10h4"/>
          <path d="M10 14h4"/>
          <path d="M10 18h4"/>
        </svg>
      </div>

      <!-- Single Combined SVG Logo Image -->
      <img
        src="/logo.svg"
        alt="Ideal Remodeling - Interiors & Remodeling"
        class="h-10 sm:h-11 w-auto object-contain filter drop-shadow-sm group-hover:opacity-90 transition-opacity"
      />
    </a>

    <!-- CENTER: Fluid Floating Nav Links with Increased Spacing -->
    <nav class="hidden lg:flex items-center space-x-2.5 lg:space-x-4 bg-warm-900/80 border border-warm-800/60 rounded-full p-2 shadow-inner" aria-label="Main Navigation">
      {
        siteConfig.navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link font-sans text-xs font-semibold uppercase tracking-editorial text-warm-400 hover:text-warm-50 hover:bg-warm-800/80 px-5 py-2 rounded-full transition-all duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- RIGHT: Perfectly Centered Direct Action CTA Button (Desktop) -->
    <div class="hidden lg:flex items-center">
      <a
        href="#contact"
        class="bg-bronze text-warm-950 hover:bg-bronze-light font-sans text-xs font-bold uppercase tracking-widest px-6 py-2.5 rounded-full transition-all duration-300 hover:scale-105 shadow-md inline-flex items-center justify-center space-x-2 leading-none"
      >
        <span class="leading-none pt-0.5">INQUIRE</span>
        <svg class="w-3.5 h-3.5 stroke-[2.5] text-warm-950 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      class="lg:hidden flex flex-col justify-center items-center w-9 h-9 rounded-full bg-warm-900 border border-warm-800 focus:outline-none focus:ring-1 focus:ring-bronze p-2"
    >
      <span class="w-4 h-0.5 bg-warm-200 transition-transform duration-300 origin-center" id="bar-top"></span>
      <span class="w-3 h-0.5 bg-warm-200 transition-opacity duration-300 my-1" id="bar-mid"></span>
      <span class="w-4 h-0.5 bg-warm-200 transition-transform duration-300 origin-center" id="bar-bot"></span>
    </button>

  </div>

  <!-- Mobile Navigation Overlay Component -->
  <MobileMenu />
</header>

<style>
  /* Header Scrolled Contracted Glass State */
  header.header-scrolled {
    background-color: rgba(18, 17, 16, 0.94);
    border-color: rgba(164, 130, 89, 0.4);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45), 0 0 25px rgba(164, 130, 89, 0.18);
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
  }
</style>
