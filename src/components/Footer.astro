---
import { siteConfig } from '../data/siteConfig';
import SocialIcons from './SocialIcons.astro';
---

<footer class="bg-warm-900 text-warm-100 py-16 md:py-24 border-t border-warm-800" aria-label="Site Footer">
  <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-16">
    
    <!-- Top Grid: Brand & Nav Links -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      
      <!-- Brand Summary -->
      <div class="md:col-span-5 space-y-4">
        <a href="#hero" class="inline-block group">
          <span class="font-sans font-medium text-lg tracking-widest text-warm-50 group-hover:text-bronze-light transition-colors block">
            {siteConfig.name}
          </span>
          <span class="text-xs tracking-editorial uppercase text-warm-400 font-sans font-light mt-0.5 block">
            {siteConfig.tagline}
          </span>
        </a>
        <p class="font-sans text-xs text-warm-400 font-light max-w-sm leading-relaxed">
          Thoughtful residential interiors, refined materials, and considered craftsmanship designed around the way you live. Based in Dallas, Texas.
        </p>
      </div>

      <!-- Quick Links Nav -->
      <div class="md:col-span-4 space-y-3">
        <span class="font-sans text-xs uppercase tracking-widest text-warm-400 font-medium block mb-2">
          NAVIGATION
        </span>
        <div class="grid grid-cols-2 gap-2 text-xs font-sans">
          {
            siteConfig.navLinks.map((link) => (
              <a
                href={link.href}
                class="text-warm-300 hover:text-warm-50 transition-colors py-1 uppercase tracking-editorial"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Social & Direct Contact -->
      <div class="md:col-span-3 space-y-4">
        <span class="font-sans text-xs uppercase tracking-widest text-warm-400 font-medium block mb-2">
          CONNECT
        </span>
        <SocialIcons className="w-5 h-5 text-warm-400" />
        <div class="pt-2 text-xs font-sans text-warm-400 space-y-1">
          <p>{siteConfig.phone}</p>
          <p>{siteConfig.email}</p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar: Copyright & Legal -->
    <div class="pt-8 border-t border-warm-800/80 flex flex-col sm:flex-row items-center justify-between text-[11px] font-sans text-warm-500 space-y-4 sm:space-y-0">
      <p>© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
      <div class="flex items-center space-x-6">
        <a href="#hero" class="hover:text-warm-300 transition-colors">Privacy Policy</a>
        <a href="#hero" class="hover:text-warm-300 transition-colors">Terms of Service</a>
        <a href="#hero" class="hover:text-warm-300 transition-colors">Sitemap</a>
      </div>
    </div>

  </div>
</footer>

