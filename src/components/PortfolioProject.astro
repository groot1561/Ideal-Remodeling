---
import type { PortfolioProject as ProjectType } from '../data/portfolio';

interface Props {
  project: ProjectType;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
---

<div
  class="portfolio-card-desktop absolute inset-0 w-full h-full bg-warm-50 flex items-center justify-center px-6 md:px-12 pt-36 md:pt-40 pb-10 overflow-hidden"
  data-index={index}
>
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center h-full max-h-[75vh]">
    
    <!-- Image Panel (Left 7 Cols) -->
    <div class="lg:col-span-7 relative h-full min-h-[380px] max-h-[60vh] rounded-sm overflow-hidden shadow-lg bg-warm-200 group">
      <img
        src={project.image}
        alt={project.imageAlt}
        class="portfolio-img w-full h-full object-cover object-center filter brightness-[0.97] transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
      <!-- Subtle Floating Badge -->
      <div class="absolute top-6 left-6 bg-warm-50/90 backdrop-blur-md px-4 py-2 text-xs font-sans uppercase tracking-editorial text-warm-900 shadow-sm">
        {project.category}
      </div>
    </div>

    <!-- Metadata & Description (Right 5 Cols) -->
    <div class="portfolio-meta lg:col-span-5 space-y-5 flex flex-col justify-center">
      
      <div class="flex items-baseline justify-between border-b border-warm-300/60 pb-3">
        <span class="font-serif text-2xl md:text-3xl text-bronze italic">
          {project.number}
        </span>
        <span class="font-sans text-xs uppercase tracking-editorial text-warm-600">
          {project.location} — {project.year}
        </span>
      </div>

      <h3 class="font-serif text-4xl md:text-5xl lg:text-5xl text-warm-900 leading-none">
        {project.title}
      </h3>

      <p class="font-sans text-base text-warm-700 font-light leading-relaxed">
        "{project.description}"
      </p>

      <!-- Project Architectural Specifications -->
      <div class="space-y-3 pt-4 border-t border-warm-300/40">
        <div class="grid grid-cols-2 gap-4 text-xs font-sans">
          <div>
            <span class="text-warm-500 block uppercase tracking-wider text-[10px]">TIMELINE</span>
            <span class="text-warm-900 font-medium">{project.specs.duration}</span>
          </div>
          <div>
            <span class="text-warm-500 block uppercase tracking-wider text-[10px]">SCOPE</span>
            <span class="text-warm-900 font-medium">{project.specs.scope}</span>
          </div>
        </div>
        <div>
          <span class="text-warm-500 block uppercase tracking-wider text-[10px]">PRIMARY MATERIALS</span>
          <span class="text-warm-800 text-xs">{project.specs.keyMaterials}</span>
        </div>
      </div>

    </div>

  </div>
</div>
