---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  index: number;
  total: number;
}

const { service, index, total } = Astro.props;
---

<!-- Desktop Service Layer -->
<div
  class="service-card-desktop absolute inset-0 w-full h-full bg-warm-50 flex items-center justify-center px-6 md:px-12 pt-36 md:pt-40 pb-10 overflow-hidden"
  data-index={index}
>
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
    
    <!-- Image Panel (Left/Center) -->
    <div class="lg:col-span-7 relative group overflow-hidden aspect-4/3 lg:aspect-16/10 rounded-sm shadow-md bg-warm-200 max-h-[60vh]">
      <div class="service-img-wrapper w-full h-full overflow-hidden">
        <img
          src={service.image}
          alt={service.imageAlt}
          class="w-full h-full object-cover object-center filter brightness-[0.96] transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-warm-950/40 via-transparent to-transparent opacity-60"></div>
    </div>

    <!-- Text & Details Content (Right) -->
    <div class="service-content-wrapper lg:col-span-5 space-y-5 lg:pl-4">
      <div class="flex items-center space-x-4">
        <span class="font-serif text-2xl md:text-3xl text-bronze italic">
          {service.number}
        </span>
        <span class="w-8 h-px bg-warm-400"></span>
        <span class="font-sans text-xs uppercase tracking-widest text-warm-600 font-medium">
          SERVICE CATEGORY
        </span>
      </div>

      <h3 class="font-serif text-3xl md:text-4xl text-warm-900 leading-tight">
        {service.title}
      </h3>

      <p class="font-sans text-base md:text-lg text-warm-800 font-medium">
        "{service.shortDesc}"
      </p>

      <p class="font-sans text-xs md:text-sm text-warm-600 font-light leading-relaxed">
        {service.fullDesc}
      </p>

      <!-- Key Service Details List -->
      <div class="pt-4 border-t border-warm-300/60">
        <h4 class="font-sans text-xs uppercase tracking-editorial text-warm-700 font-semibold mb-3">
          KEY FOCUS AREAS
        </h4>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-warm-600">
          {service.details.map((detail) => (
            <li class="flex items-center space-x-2">
              <span class="w-1.5 h-1.5 rounded-full bg-bronze"></span>
              <span>{detail}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

  </div>
</div>
