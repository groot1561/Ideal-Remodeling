---
import { siteConfig } from '../data/siteConfig';

const principles = [
  {
    num: "01",
    title: "Lifestyle & Discovery",
    text: "We listen closely to how you live, cook, gather, and unwind—shaping floor plans around your personal daily rhythms."
  },
  {
    num: "02",
    title: "Material Intentionality",
    text: "Selecting tactile, enduring natural materials—unlacquered metals, solid hardwoods, and honed stones that patina gracefully over time."
  },
  {
    num: "03",
    title: "Craftsmanship & Precision",
    text: "Partnering with master cabinetmakers and stonemasons to execute exact joinery, flush architectural trim, and seamless finishes."
  }
];
---

<section id="approach" class="relative bg-warm-100 py-24 md:py-36 overflow-hidden" aria-label="Our Approach">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- LEFT COLUMN: Large Editorial Image (Sticky Locked on Scroll) -->
      <div class="lg:col-span-6 lg:sticky lg:top-28 relative aspect-4/5 md:aspect-3/4 rounded-sm overflow-hidden shadow-xl bg-warm-200 group">
        <img
          src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1600&q=85"
          alt="Architectural material palette with natural limestone, oak sample, and bronze hardware"
          class="approach-img w-full h-full object-cover object-center filter brightness-[0.96] transition-transform duration-1000"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-warm-950/40 via-transparent to-transparent"></div>
        
        <!-- Image Caption Overlay -->
        <div class="absolute bottom-6 left-6 right-6 text-warm-50 font-sans text-xs uppercase tracking-editorial flex items-center justify-between">
          <span>DESIGN PHILOSOPHY</span>
          <span>DALLAS STUDIO</span>
        </div>
      </div>

      <!-- RIGHT COLUMN: Editorial Text Narrative & Principles -->
      <div class="lg:col-span-6 space-y-8 lg:pl-6">
        
        <div class="approach-text-item space-y-4">
          <span class="font-sans text-xs uppercase tracking-widest text-bronze block font-medium">
            04 — OUR APPROACH
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-warm-900 leading-[1.08]">
            Every Space Begins With Understanding.
          </h2>
        </div>

        <p class="approach-text-item font-sans text-lg md:text-xl text-warm-800 font-light leading-relaxed italic border-l-2 border-bronze pl-6">
          "We begin by understanding how you live, what you value, and what your space needs. From the first idea to the final detail, every decision is made with intention."
        </p>

        <p class="approach-text-item font-sans text-sm md:text-base text-warm-600 font-light leading-relaxed">
          Residential remodeling is far more than changing surfaces; it is the discipline of enhancing proportion, spatial flow, and emotional resonance. Our process integrates interior design with rigorous construction management, ensuring every wall moved and stone laid serves both beauty and longevity.
        </p>

        <!-- Principles List -->
        <div class="approach-text-item pt-6 border-t border-warm-300/60 space-y-6">
          {principles.map((p) => (
            <div class="flex items-start space-x-4">
              <span class="font-serif text-xl text-bronze italic pt-0.5">{p.num}</span>
              <div class="space-y-1">
                <h3 class="font-serif text-xl text-warm-900">{p.title}</h3>
                <p class="font-sans text-xs md:text-sm text-warm-600 font-light leading-relaxed">{p.text}</p>
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>
