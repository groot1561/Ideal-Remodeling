---
import { siteConfig } from '../data/siteConfig';
import ContactForm from './ContactForm.astro';
import SocialIcons from './SocialIcons.astro';

// Generate dense dot matrices (8 columns x 10 rows = 80 dots per side)
const leftDots = Array.from({ length: 80 }).map((_, i) => ({
  id: i,
  delay: ((i * 0.17) % 4).toFixed(2),
  duration: (2.0 + ((i * 0.23) % 2.5)).toFixed(2),
  size: i % 7 === 0 ? "w-2 h-2" : i % 3 === 0 ? "w-1.5 h-1.5" : "w-1 h-1",
}));

const rightDots = Array.from({ length: 80 }).map((_, i) => ({
  id: i,
  delay: ((i * 0.21) % 4.2).toFixed(2),
  duration: (1.8 + ((i * 0.29) % 2.7)).toFixed(2),
  size: i % 5 === 0 ? "w-2 h-2" : i % 4 === 0 ? "w-1.5 h-1.5" : "w-1 h-1",
}));
---

<section id="contact" class="relative bg-warm-900 text-warm-100 py-24 md:py-36 overflow-hidden border-t border-warm-800" aria-label="Contact and Inquiries">
  
  <!-- ============================================================ -->
  <!-- LEFT FLANK ANIMATED MOVING DOT MATRIX & STRIPES -->
  <!-- ============================================================ -->
  <div class="absolute inset-y-0 left-0 w-1/4 md:w-1/3 pointer-events-none overflow-hidden hidden sm:block z-0 opacity-80">
    <!-- Moving Vertical Light Stripes -->
    <div class="stripe-beam absolute left-1/6 top-0 w-px h-full bg-gradient-to-b from-transparent via-bronze/50 to-transparent"></div>
    <div class="stripe-beam-slow absolute left-1/2 top-0 w-px h-full bg-gradient-to-b from-transparent via-warm-500/30 to-transparent"></div>
    <div class="stripe-beam absolute left-5/6 top-0 w-px h-full bg-gradient-to-b from-transparent via-bronze/40 to-transparent"></div>
    
    <!-- Dense Blinking Dot Matrix (8 Cols x 10 Rows) -->
    <div class="absolute inset-0 grid grid-cols-6 lg:grid-cols-8 gap-y-6 gap-x-3 p-4 items-center">
      {leftDots.map((dot) => (
        <div
          class={`blinking-dot ${dot.size} rounded-full bg-bronze/70 shadow-[0_0_8px_rgba(164,130,89,0.85)] mx-auto`}
          style={`animation-delay: ${dot.delay}s; animation-duration: ${dot.duration}s;`}
        ></div>
      ))}
    </div>

    <!-- Architectural Coordinate Label -->
    <div class="absolute bottom-12 left-6 font-sans text-[10px] tracking-widest text-warm-500 uppercase transform -rotate-90 origin-left">
      STUDIO COORD // 32.7767° N, 96.7970° W
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- RIGHT FLANK ANIMATED MOVING DOT MATRIX & STRIPES -->
  <!-- ============================================================ -->
  <div class="absolute inset-y-0 right-0 w-1/4 md:w-1/3 pointer-events-none overflow-hidden hidden sm:block z-0 opacity-80">
    <!-- Moving Vertical Light Stripes -->
    <div class="stripe-beam-slow absolute right-1/6 top-0 w-px h-full bg-gradient-to-b from-transparent via-bronze/50 to-transparent"></div>
    <div class="stripe-beam absolute right-1/2 top-0 w-px h-full bg-gradient-to-b from-transparent via-warm-500/30 to-transparent"></div>
    <div class="stripe-beam-slow absolute right-5/6 top-0 w-px h-full bg-gradient-to-b from-transparent via-bronze/40 to-transparent"></div>
    
    <!-- Dense Blinking Dot Matrix (8 Cols x 10 Rows) -->
    <div class="absolute inset-0 grid grid-cols-6 lg:grid-cols-8 gap-y-6 gap-x-3 p-4 items-center">
      {rightDots.map((dot) => (
        <div
          class={`blinking-dot ${dot.size} rounded-full bg-bronze/70 shadow-[0_0_8px_rgba(164,130,89,0.85)] mx-auto`}
          style={`animation-delay: ${dot.delay}s; animation-duration: ${dot.duration}s;`}
        ></div>
      ))}
    </div>

    <!-- Architectural Spec Label -->
    <div class="absolute top-12 right-6 font-sans text-[10px] tracking-widest text-warm-500 uppercase transform rotate-90 origin-right">
      SPEC // IDEAL REMODELING DALLAS
    </div>
  </div>

  <!-- Ambient Central Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-bronze/5 rounded-full filter blur-3xl pointer-events-none z-0"></div>


  <!-- ============================================================ -->
  <!-- CENTERED CONTENT & INQUIRY TABLE -->
  <!-- ============================================================ -->
  <div class="max-w-4xl mx-auto px-6 relative z-10 space-y-12">
    
    <!-- Section Header (Centered) -->
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <div class="inline-flex items-center space-x-3">
        <span class="w-6 h-px bg-bronze"></span>
        <span class="font-sans text-xs uppercase tracking-widest text-bronze font-medium">
          05 — START A CONVERSATION
        </span>
        <span class="w-6 h-px bg-bronze"></span>
      </div>

      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-warm-50 leading-[1.06]">
        Initiate Your Transformation.
      </h2>

      <p class="font-sans text-base text-warm-300 font-light leading-relaxed">
        We accept a curated selection of residential commissions each year to ensure uncompromising craftsmanship and dedicated studio attention.
      </p>
    </div>

    <!-- Centered Studio Quick Specs Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-4 bg-warm-950/90 border border-warm-800 rounded-sm text-center text-xs font-sans shadow-xl">
      <div>
        <span class="text-warm-500 block uppercase tracking-wider text-[10px]">STUDIO LOCATION</span>
        <span class="text-warm-100 font-medium">{siteConfig.location}</span>
      </div>
      <div>
        <span class="text-warm-500 block uppercase tracking-wider text-[10px]">DIRECT PHONE</span>
        <a href={`tel:${siteConfig.phone}`} class="text-warm-100 hover:text-bronze font-medium">
          {siteConfig.phone}
        </a>
      </div>
      <div>
        <span class="text-warm-500 block uppercase tracking-wider text-[10px]">EMAIL INQUIRIES</span>
        <a href={`mailto:${siteConfig.email}`} class="text-warm-100 hover:text-bronze font-medium">
          {siteConfig.email}
        </a>
      </div>
      <div>
        <span class="text-warm-500 block uppercase tracking-wider text-[10px]">OPERATING HOURS</span>
        <span class="text-warm-100 font-medium">Mon – Fri: 8am – 6pm</span>
      </div>
    </div>

    <!-- CENTERED PROJECT INQUIRY FORM CARD -->
    <div class="contact-reveal">
      <ContactForm />
    </div>

    <!-- Centered Social Links -->
    <div class="flex items-center justify-center space-x-6 pt-4">
      <span class="text-xs uppercase tracking-editorial text-warm-500 font-sans">CONNECT WITH US</span>
      <SocialIcons className="w-4 h-4 text-warm-400" />
    </div>

  </div>
</section>

<style>
  /* Blinking Dots Animation */
  @keyframes blinkPulse {
    0%, 100% {
      opacity: 0.12;
      transform: scale(0.75);
      box-shadow: 0 0 2px rgba(164, 130, 89, 0.15);
    }
    50% {
      opacity: 1;
      transform: scale(1.6);
      box-shadow: 0 0 14px rgba(164, 130, 89, 0.95);
    }
  }

  .blinking-dot {
    animation: blinkPulse infinite ease-in-out;
  }

  /* Moving Light Stripe Beam Animations */
  @keyframes stripeMove {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    50% {
      opacity: 0.85;
    }
    100% {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .stripe-beam {
    animation: stripeMove 4.5s infinite linear;
  }

  .stripe-beam-slow {
    animation: stripeMove 7.5s infinite linear;
    animation-delay: 2.5s;
  }
</style>
