---
import { siteConfig } from '../data/siteConfig';
---

<section
  id="hero"
  class="relative w-full min-h-[90vh] md:min-h-screen flex items-center pt-24 pb-16 md:py-32 overflow-hidden bg-warm-50"
  aria-label="Hero Introduction"
>
  <!-- Background Image with Parallax Wrapper -->
  <div class="hero-bg-wrapper absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none">
    <img
      src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=90"
      alt="Warm minimalist luxury interior design with oak architectural details and warm sunlight"
      class="hero-bg-img w-full h-full object-cover object-center filter brightness-[0.92] contrast-[0.98]"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Subtle Warm Overlay Gradient for Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-warm-50/90 via-warm-50/70 to-warm-50/20 md:from-warm-50/95 md:via-warm-50/65 md:to-warm-50/10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-warm-50 via-transparent to-warm-50/30"></div>
  </div>

  <!-- Hero Content Container -->
  <div class="hero-content relative z-10 max-w-7xl mx-auto px-6 md:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-8 space-y-6 md:space-y-8">
      
      <!-- Small Label -->
      <div class="hero-label inline-flex items-center space-x-3">
        <span class="w-8 h-px bg-bronze"></span>
        <span class="font-sans text-xs uppercase tracking-widest text-warm-700 font-medium">
          {siteConfig.tagline}
        </span>
      </div>

      <!-- Main Editorial Serif Headline -->
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl tracking-tight text-warm-900 leading-[1.04]">
        <span class="hero-headline-line block">Spaces Made</span>
        <span class="hero-headline-line block italic font-normal text-warm-800">Distinctly Yours.</span>
      </h1>

      <!-- Supporting Subheadline -->
      <p class="hero-subheadline font-sans text-base md:text-xl text-warm-700 max-w-xl font-light leading-relaxed">
        {siteConfig.heroSubheadline}
      </p>

      <!-- Action Buttons & Links -->
      <div class="hero-cta pt-4 flex flex-col sm:flex-row items-start sm:items-center space-y-4 sm:space-y-0 sm:space-x-8">
        <!-- Primary CTA -->
        <a
          href="#work"
          class="inline-block bg-warm-900 text-warm-50 font-sans text-xs uppercase tracking-editorial px-8 py-4 hover:bg-bronze transition-colors duration-300 rounded-none shadow-sm focus:outline-none focus:ring-2 focus:ring-bronze"
        >
          EXPLORE OUR WORK
        </a>

        <!-- Secondary Text Link -->
        <a
          href="#contact"
          class="inline-flex items-center space-x-2 text-warm-800 hover:text-bronze font-sans text-xs uppercase tracking-editorial font-medium transition-colors duration-200 group py-2"
        >
          <span>START A CONVERSATION</span>
          <span class="inline-block transform group-hover:translate-x-1.5 transition-transform duration-200">→</span>
        </a>
      </div>

    </div>
  </div>
</section>
